# Unity tarafından üretilen klasörler (her makinede yeniden oluşur)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Captures/

# IDE ve proje dosyaları
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Çökme raporları ve geçici dosyalar
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.tmp

# Ofis-Garaj (arkadaşın projesinden birleştirildi)
*.pidb.meta
*.pdb.meta
*.mdb.meta
crashlytics-buildid.txt
# Python önbellekleri ve Blender otomatik yedekleri (.blend kaynakları izlenir)
__pycache__/
*.py[cod]
*.blend[1-9]

# Blender/OptiX kernel önbelleği (makineye özel)
ArtPipeline/Export/**/cache/

# Sel Vadisi saha haritası: sahne, ~220 MB mesh ve görev malzemesi her makinede üretilir (Git'e girmez).
# Unity ilk açılışta sorar; elle: Rescue Team > Sel Vadisi > Haritayı Yeniden Üret ve Görevi Kur
/Assets/SelVadisi/Generated/
/Assets/SelVadisi/Generated.meta
/Assets/SelVadisi/Gorev/
/Assets/SelVadisi/Gorev.meta
/Assets/SelVadisi/SelVadisi_BuyukHarita.unity
/Assets/SelVadisi/SelVadisi_BuyukHarita.unity.meta
